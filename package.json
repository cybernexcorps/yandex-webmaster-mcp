{
  "name": "@cybernexcorps/yandex-webmaster-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for the Yandex Webmaster v4 API — 29 tools covering diagnostics, indexing, SQI, sitemaps, recrawl, search queries, and backlinks.",
  "type": "module",
  "bin": {
    "yandex-webmaster-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "smoke": "tsx src/smoke-test.ts",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yandex",
    "yandex-webmaster",
    "webmaster",
    "seo",
    "search-console"
  ],
  "author": "Slava Pospelov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cybernexcorps/yandex-webmaster-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cybernexcorps/yandex-webmaster-mcp/issues"
  },
  "homepage": "https://github.com/cybernexcorps/yandex-webmaster-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
